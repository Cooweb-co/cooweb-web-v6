---
import InnerLayout from '../../layouts/InnerLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageBanner from '../../components/PageBanner.astro';
---

<InnerLayout
  title="DerbiPlay - Plataforma de Fútbol Amateur | CooWeb"
  description="DerbiPlay revoluciona la organización de partidos de fútbol amateur, digitalizando el talento y creando oportunidades para brillar en cada partido."
  keywords="derbiplay, fútbol amateur, organización de partidos, talento deportivo, impacto social, digitalización deportiva"
>
  <Header />

  <div id="smooth-wrapper">
    <div id="smooth-content">
      <main>
        <PageBanner
          subtitle="Proyecto: DerbiPlay"
          title="El Futuro del <br> Fútbol Amateur"
        />

        <!--====== Start Project Hero Section ======-->
        <section class="project-hero-sec pt-130 pb-90">
          <div class="container">
            <div class="row align-items-center">
              <div class="col-lg-6">
                <div class="content-box mb-50" data-aos="fade-up" data-aos-duration="1000">
                  <span class="badge mb-20" style="background: #10b981; color: white; padding: 8px 16px; border-radius: 20px; font-size: 14px;">BETA</span>
                  <h2 class="mb-30">Haz tu fútbol más Organizado</h2>
                  <p class="lead mb-30" style="font-size: 18px; line-height: 1.8;">
                    La plataforma que hace fácil organizar partidos, encontrar jugadores y gestionar equipos.
                    Todo en un solo lugar.
                  </p>
                  <div class="xeno-button mb-30">
                    <a href="#" class="theme-btn style-one" style="margin-right: 15px;">
                      Crear Partido <i class="far fa-arrow-right"></i>
                    </a>
                    <a href="#" class="theme-btn style-two">
                      Registrarse <i class="far fa-arrow-right"></i>
                    </a>
                  </div>
                  <p style="color: #666;">
                    🎉 <strong>¡Más de 1,000 partidos organizados en nuestra plataforma!</strong>
                  </p>
                </div>
              </div>
              <div class="col-lg-6">
                <div class="image-box mb-50" data-aos="fade-up" data-aos-duration="1300">
                  <img src="https://images.unsplash.com/photo-1579952363873-27f3bade9f55?w=800&h=600&fit=crop" alt="DerbiPlay - Fútbol Amateur" style="border-radius: 10px; width: 100%;">
                </div>
              </div>
            </div>

            <!--=== Stats ===-->
            <div class="row mt-30">
              <div class="col-lg-3 col-md-6">
                <div class="stat-card mb-40" data-aos="fade-up" data-aos-duration="800">
                  <div style="background: #f8f9fa; padding: 30px; border-radius: 10px; text-align: center;">
                    <h3 style="color: #007bff; margin-bottom: 10px;">1.2K+</h3>
                    <p style="margin: 0; color: #666;">Jugadores</p>
                  </div>
                </div>
              </div>
              <div class="col-lg-3 col-md-6">
                <div class="stat-card mb-40" data-aos="fade-up" data-aos-duration="1000">
                  <div style="background: #f8f9fa; padding: 30px; border-radius: 10px; text-align: center;">
                    <h3 style="color: #007bff; margin-bottom: 10px;">4.8</h3>
                    <p style="margin: 0; color: #666;">Valoración</p>
                  </div>
                </div>
              </div>
              <div class="col-lg-3 col-md-6">
                <div class="stat-card mb-40" data-aos="fade-up" data-aos-duration="1200">
                  <div style="background: #f8f9fa; padding: 30px; border-radius: 10px; text-align: center;">
                    <h3 style="color: #007bff; margin-bottom: 10px;">98%</h3>
                    <p style="margin: 0; color: #666;">Satisfacción</p>
                  </div>
                </div>
              </div>
              <div class="col-lg-3 col-md-6">
                <div class="stat-card mb-40" data-aos="fade-up" data-aos-duration="1400">
                  <div style="background: #f8f9fa; padding: 30px; border-radius: 10px; text-align: center;">
                    <h3 style="color: #007bff; margin-bottom: 10px;">24/7</h3>
                    <p style="margin: 0; color: #666;">Soporte</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!--====== Start Features Section ======-->
        <section class="features-sec pt-60 pb-90" style="background: #f8f9fa;">
          <div class="container">
            <div class="row">
              <div class="col-12">
                <div class="section-title text-center mb-60" data-aos="fade-up" data-aos-duration="1000">
                  <span class="subtitle">Características Principales</span>
                  <h3>Todo lo que necesitas para organizar partidos exitosos</h3>
                </div>
              </div>
            </div>
            <div class="row">
              <div class="col-xl-3 col-md-6">
                <div class="xeno-feature-item mb-40" data-aos="fade-up" data-aos-duration="800">
                  <div class="icon">
                    <i class="flaticon-solution"></i>
                  </div>
                  <div class="content">
                    <h5>Organización Simple</h5>
                    <p>Crea y gestiona partidos en minutos, sin complicaciones.</p>
                    <div class="stat mt-15">
                      <strong style="color: #007bff;">2 min</strong>
                      <span style="font-size: 14px; color: #666;"> tiempo promedio</span>
                    </div>
                  </div>
                </div>
              </div>
              <div class="col-xl-3 col-md-6">
                <div class="xeno-feature-item mb-40" data-aos="fade-up" data-aos-duration="1000">
                  <div class="icon">
                    <i class="flaticon-team"></i>
                  </div>
                  <div class="content">
                    <h5>Equipos Equilibrados</h5>
                    <p>Sistema inteligente de distribución de jugadores por nivel.</p>
                    <div class="stat mt-15">
                      <strong style="color: #007bff;">95%</strong>
                      <span style="font-size: 14px; color: #666;"> partidos equilibrados</span>
                    </div>
                  </div>
                </div>
              </div>
              <div class="col-xl-3 col-md-6">
                <div class="xeno-feature-item mb-40" data-aos="fade-up" data-aos-duration="1200">
                  <div class="icon">
                    <i class="flaticon-tech-service"></i>
                  </div>
                  <div class="content">
                    <h5>Sistema de XP</h5>
                    <p>Gana experiencia, sube de nivel y desbloquea logros.</p>
                    <div class="stat mt-15">
                      <strong style="color: #007bff;">50+</strong>
                      <span style="font-size: 14px; color: #666;"> logros disponibles</span>
                    </div>
                  </div>
                </div>
              </div>
              <div class="col-xl-3 col-md-6">
                <div class="xeno-feature-item mb-40" data-aos="fade-up" data-aos-duration="1400">
                  <div class="icon">
                    <i class="flaticon-hypothesis"></i>
                  </div>
                  <div class="content">
                    <h5>Calificaciones</h5>
                    <p>Valora el rendimiento y deportividad de los jugadores.</p>
                    <div class="stat mt-15">
                      <strong style="color: #007bff;">4.8/5</strong>
                      <span style="font-size: 14px; color: #666;"> rating promedio</span>
                    </div>
                  </div>
                </div>
              </div>
              <div class="col-xl-3 col-md-6">
                <div class="xeno-feature-item mb-40" data-aos="fade-up" data-aos-duration="800">
                  <div class="icon">
                    <i class="flaticon-team"></i>
                  </div>
                  <div class="content">
                    <h5>Jugadores Verificados</h5>
                    <p>Comunidad confiable con verificación de identidad.</p>
                    <div class="stat mt-15">
                      <strong style="color: #007bff;">100%</strong>
                      <span style="font-size: 14px; color: #666;"> usuarios verificados</span>
                    </div>
                  </div>
                </div>
              </div>
              <div class="col-xl-3 col-md-6">
                <div class="xeno-feature-item mb-40" data-aos="fade-up" data-aos-duration="1000">
                  <div class="icon">
                    <i class="flaticon-solution"></i>
                  </div>
                  <div class="content">
                    <h5>Rankings y Torneos</h5>
                    <p>Compite en torneos y sube en el ranking.</p>
                    <div class="stat mt-15">
                      <strong style="color: #007bff;">24/7</strong>
                      <span style="font-size: 14px; color: #666;"> competiciones activas</span>
                    </div>
                  </div>
                </div>
              </div>
              <div class="col-xl-3 col-md-6">
                <div class="xeno-feature-item mb-40" data-aos="fade-up" data-aos-duration="1200">
                  <div class="icon">
                    <i class="flaticon-tech-service"></i>
                  </div>
                  <div class="content">
                    <h5>Recordatorios</h5>
                    <p>Notificaciones y recordatorios automáticos.</p>
                    <div class="stat mt-15">
                      <strong style="color: #007bff;">1h antes</strong>
                      <span style="font-size: 14px; color: #666;"> recordatorio</span>
                    </div>
                  </div>
                </div>
              </div>
              <div class="col-xl-3 col-md-6">
                <div class="xeno-feature-item mb-40" data-aos="fade-up" data-aos-duration="1400">
                  <div class="icon">
                    <i class="flaticon-hypothesis"></i>
                  </div>
                  <div class="content">
                    <h5>Pagos Integrados</h5>
                    <p>División de costos y pagos simplificados.</p>
                    <div class="stat mt-15">
                      <strong style="color: #007bff;">0%</strong>
                      <span style="font-size: 14px; color: #666;"> comisión</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!--====== Start Why DerbiPlay Section ======-->
        <section class="why-derbiplay-sec pt-130 pb-90">
          <div class="container">
            <div class="row">
              <div class="col-12">
                <div class="section-title text-center mb-60" data-aos="fade-up" data-aos-duration="1000">
                  <span class="subtitle">¿Por qué DerbiPlay?</span>
                  <h3>Descubre cómo revolucionamos la organización de partidos</h3>
                </div>
              </div>
            </div>
            <div class="row">
              <div class="col-lg-6">
                <div class="image-box mb-50" data-aos="fade-up" data-aos-duration="1000">
                  <img src="https://images.unsplash.com/photo-1574629810360-7efbbe195018?w=800&h=600&fit=crop" alt="Partidos organizados" style="border-radius: 10px; width: 100%;">
                </div>
              </div>
              <div class="col-lg-6">
                <div class="content-box mb-50" data-aos="fade-up" data-aos-duration="1300">
                  <div class="benefit-item mb-40">
                    <h4 class="mb-15">⚡ Rápido y Eficiente</h4>
                    <p class="mb-10">Organiza partidos en menos de 2 minutos</p>
                    <div class="stat">
                      <strong style="color: #007bff; font-size: 24px;">1.5K+</strong>
                      <span style="margin-left: 10px; color: #666;">Partidos Organizados</span>
                    </div>
                  </div>
                  <div class="benefit-item mb-40">
                    <h4 class="mb-15">✅ Jugadores Verificados</h4>
                    <p class="mb-10">Comunidad confiable de deportistas</p>
                    <div class="stat">
                      <strong style="color: #007bff; font-size: 24px;">98%</strong>
                      <span style="margin-left: 10px; color: #666;">Jugadores Verificados</span>
                    </div>
                  </div>
                  <div class="benefit-item mb-40">
                    <h4 class="mb-15">🎯 Partidos a tu Nivel</h4>
                    <p class="mb-10">Encuentra jugadores de tu mismo nivel</p>
                    <div class="stat">
                      <strong style="color: #007bff; font-size: 24px;">4.8/5</strong>
                      <span style="margin-left: 10px; color: #666;">Rating Promedio</span>
                    </div>
                  </div>
                  <div class="benefit-item mb-40">
                    <h4 class="mb-15">📱 Siempre Conectado</h4>
                    <p class="mb-10">Gestiona todo desde tu móvil</p>
                    <div class="stat">
                      <strong style="color: #007bff; font-size: 24px;">24/7</strong>
                      <span style="margin-left: 10px; color: #666;">Soporte Activo</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!--====== Start How It Works Section ======-->
        <section class="how-it-works-sec pt-90 pb-130" style="background: #f8f9fa;">
          <div class="container">
            <div class="row">
              <div class="col-12">
                <div class="section-title text-center mb-60" data-aos="fade-up" data-aos-duration="1000">
                  <span class="subtitle">¿Cómo Funciona?</span>
                  <h3>Organizar y unirse a partidos es más fácil que nunca</h3>
                </div>
              </div>
            </div>
            <div class="row">
              <div class="col-lg-3 col-md-6">
                <div class="step-card mb-40" data-aos="fade-up" data-aos-duration="800" style="background: white; padding: 30px; border-radius: 10px; text-align: center; height: 100%;">
                  <div class="step-number mb-20" style="width: 60px; height: 60px; background: #007bff; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 24px; font-weight: bold; margin: 0 auto;">1</div>
                  <h5 class="mb-15">Regístrate</h5>
                  <p>Crea tu cuenta en segundos con tu número de teléfono</p>
                </div>
              </div>
              <div class="col-lg-3 col-md-6">
                <div class="step-card mb-40" data-aos="fade-up" data-aos-duration="1000" style="background: white; padding: 30px; border-radius: 10px; text-align: center; height: 100%;">
                  <div class="step-number mb-20" style="width: 60px; height: 60px; background: #10b981; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 24px; font-weight: bold; margin: 0 auto;">2</div>
                  <h5 class="mb-15">Crea o Únete</h5>
                  <p>Organiza un partido o únete a uno existente</p>
                </div>
              </div>
              <div class="col-lg-3 col-md-6">
                <div class="step-card mb-40" data-aos="fade-up" data-aos-duration="1200" style="background: white; padding: 30px; border-radius: 10px; text-align: center; height: 100%;">
                  <div class="step-number mb-20" style="width: 60px; height: 60px; background: #f59e0b; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 24px; font-weight: bold; margin: 0 auto;">3</div>
                  <h5 class="mb-15">Forma Equipo</h5>
                  <p>El sistema equilibra los equipos según nivel y posición</p>
                </div>
              </div>
              <div class="col-lg-3 col-md-6">
                <div class="step-card mb-40" data-aos="fade-up" data-aos-duration="1400" style="background: white; padding: 30px; border-radius: 10px; text-align: center; height: 100%;">
                  <div class="step-number mb-20" style="width: 60px; height: 60px; background: #8b5cf6; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 24px; font-weight: bold; margin: 0 auto;">4</div>
                  <h5 class="mb-15">Juega y Gana</h5>
                  <p>Disfruta del partido y gana experiencia</p>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!--====== Start Payments & Certification Section ======-->
        <section class="payments-sec pt-130 pb-90">
          <div class="container">
            <div class="row">
              <div class="col-12">
                <div class="section-title text-center mb-60" data-aos="fade-up" data-aos-duration="1000">
                  <span class="subtitle">Pagos Seguros y Certificación</span>
                  <h3>Gana dinero jugando al fútbol de manera segura</h3>
                  <p class="mt-20">Sistema de pagos verificado y certificación oficial</p>
                </div>
              </div>
            </div>
            <div class="row">
              <div class="col-lg-4 col-md-6">
                <div class="payment-card mb-40" data-aos="fade-up" data-aos-duration="800" style="background: #f8f9fa; padding: 30px; border-radius: 10px; height: 100%;">
                  <div class="icon mb-20" style="font-size: 48px;">💰</div>
                  <h5 class="mb-15">Ganancias por Partido</h5>
                  <p>Recibe pagos por cada partido jugado. Establece tus tarifas y gestiona tus ingresos de manera profesional.</p>
                </div>
              </div>
              <div class="col-lg-4 col-md-6">
                <div class="payment-card mb-40" data-aos="fade-up" data-aos-duration="1000" style="background: #f8f9fa; padding: 30px; border-radius: 10px; height: 100%;">
                  <div class="icon mb-20" style="font-size: 48px;">📄</div>
                  <h5 class="mb-15">Contratos Profesionales</h5>
                  <p>Firma contratos digitales con equipos. Transferencias y acuerdos seguros con garantías legales.</p>
                </div>
              </div>
              <div class="col-lg-4 col-md-6">
                <div class="payment-card mb-40" data-aos="fade-up" data-aos-duration="1200" style="background: #f8f9fa; padding: 30px; border-radius: 10px; height: 100%;">
                  <div class="icon mb-20" style="font-size: 48px;">🏆</div>
                  <h5 class="mb-15">Certificación DerbiPlay</h5>
                  <p>Obtén tu certificación oficial y aumenta tus oportunidades de ingresos con una evaluación profesional.</p>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!--====== Start Social Impact Section ======-->
        <section class="social-impact-sec pt-90 pb-130" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
          <div class="container">
            <div class="row align-items-center">
              <div class="col-lg-6">
                <div class="content-box mb-50" data-aos="fade-up" data-aos-duration="1000">
                  <h3 style="color: white; margin-bottom: 20px;">💡 Impacto Social: Digitalizando el Talento</h3>
                  <p style="font-size: 18px; line-height: 1.8; color: rgba(255,255,255,0.95); margin-bottom: 20px;">
                    DerbiPlay no es solo una app de fútbol. Es una plataforma que <strong>democratiza las oportunidades</strong>
                    en el deporte amateur.
                  </p>
                  <p style="font-size: 16px; line-height: 1.8; color: rgba(255,255,255,0.9); margin-bottom: 20px;">
                    Para algunos, el fútbol es amateur. Para otros, <strong>cada partido es una oportunidad de brillar</strong>.
                    DerbiPlay une el talento y muestra su fútbol al mundo de manera organizada y digital.
                  </p>
                  <ul style="list-style: none; padding: 0; margin-bottom: 0;">
                    <li style="margin-bottom: 15px; font-size: 16px;">✅ Búsqueda de talento de manera orgánica y digital</li>
                    <li style="margin-bottom: 15px; font-size: 16px;">✅ Digitalización de partidos y cotejos deportivos</li>
                    <li style="margin-bottom: 15px; font-size: 16px;">✅ Oportunidades reales para jugadores sin conexiones</li>
                    <li style="margin-bottom: 15px; font-size: 16px;">✅ Sistema de calificación justo y transparente</li>
                    <li style="margin-bottom: 0; font-size: 16px;">✅ Monetización para jugadores amateur con talento</li>
                  </ul>
                </div>
              </div>
              <div class="col-lg-6">
                <div class="image-box mb-50" data-aos="fade-up" data-aos-duration="1300">
                  <img src="https://images.unsplash.com/photo-1431324155629-1a6deb1dec8d?w=800&h=600&fit=crop" alt="Impacto social DerbiPlay" style="border-radius: 10px; width: 100%;">
                </div>
              </div>
            </div>
          </div>
        </section>

        <!--====== Start CTA Section ======-->
        <section class="cta-sec pt-130 pb-130">
          <div class="container">
            <div class="row text-center">
              <div class="col-12">
                <div class="cta-content" data-aos="fade-up" data-aos-duration="1000">
                  <h3 class="mb-20">Empieza a Jugar Hoy Mismo</h3>
                  <p class="mb-40" style="font-size: 18px; color: #666; max-width: 700px; margin: 0 auto 40px;">
                    Únete a la comunidad de jugadores y disfruta del deporte de una manera más organizada y profesional.
                  </p>
                  <div class="stats-row mb-40" style="display: flex; justify-content: center; gap: 40px; flex-wrap: wrap;">
                    <div class="stat-item">
                      <h4 style="color: #007bff; margin-bottom: 5px;">1,500+</h4>
                      <p style="margin: 0; color: #666;">Partidos Organizados</p>
                    </div>
                    <div class="stat-item">
                      <h4 style="color: #007bff; margin-bottom: 5px;">5,000+</h4>
                      <p style="margin: 0; color: #666;">Jugadores Activos</p>
                    </div>
                    <div class="stat-item">
                      <h4 style="color: #007bff; margin-bottom: 5px;">98%</h4>
                      <p style="margin: 0; color: #666;">Satisfacción</p>
                    </div>
                  </div>
                  <div class="xeno-button">
                    <a href="#" class="theme-btn style-one" style="margin-right: 15px;">
                      Crear Partido <i class="far fa-arrow-right"></i>
                    </a>
                    <a href="#" class="theme-btn style-two">
                      Crear Cuenta <i class="far fa-arrow-right"></i>
                    </a>
                  </div>
                  <div class="benefits-list mt-40" style="display: flex; justify-content: center; gap: 30px; flex-wrap: wrap;">
                    <span style="color: #666;">✓ Sin comisiones ocultas</span>
                    <span style="color: #666;">✓ Soporte 24/7</span>
                    <span style="color: #666;">✓ Cancelación gratuita</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!--====== Start Project Info Section ======-->
        <section class="project-info-sec pt-90 pb-130" style="background: #f8f9fa;">
          <div class="container">
            <div class="row">
              <div class="col-lg-8">
                <div class="content-box mb-50" data-aos="fade-up" data-aos-duration="1000">
                  <h4 class="mb-30">Sobre el Proyecto</h4>
                  <p class="mb-20">
                    DerbiPlay nació de la necesidad de digitalizar y profesionalizar el fútbol amateur en América Latina.
                    Desarrollado por <strong>CooWeb</strong>, este proyecto combina tecnología de punta con un profundo
                    entendimiento de la cultura deportiva.
                  </p>
                  <p class="mb-20">
                    La plataforma no solo facilita la organización de partidos, sino que crea un <strong>ecosistema completo</strong>
                    donde jugadores pueden desarrollar su carrera, ser descubiertos por scouts, y monetizar su talento.
                  </p>
                  <p>
                    Con un enfoque en <strong>impacto social</strong>, DerbiPlay democratiza el acceso a oportunidades deportivas,
                    permitiendo que el talento prevalezca sobre las conexiones.
                  </p>
                </div>
              </div>
              <div class="col-lg-4">
                <div class="info-box mb-50" data-aos="fade-up" data-aos-duration="1300" style="background: white; padding: 30px; border-radius: 10px;">
                  <h5 class="mb-30">Detalles del Proyecto</h5>
                  <ul style="list-style: none; padding: 0; margin: 0;">
                    <li style="margin-bottom: 20px; padding-bottom: 20px; border-bottom: 1px solid #e5e5e5;">
                      <strong>Cliente:</strong><br>
