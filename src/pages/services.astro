---
import InnerLayout from '../layouts/InnerLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageBanner from '../components/PageBanner.astro';
import Services from '../components/sections/Services.astro';
---

<InnerLayout
  title="Our Services - Xeno Creative Agency"
  description="Innovative services for digital excellence. Explore our comprehensive range of digital services"
  keywords="services, digital services, web design, branding, marketing, SEO"
>
  <Header />

  <div id="smooth-wrapper">
    <div id="smooth-content">
      <main>
        <PageBanner
          subtitle="Services We Provide"
          title="Innovative Services for Digital Excellence"
        />

        <!--======  Start Services Section  ======-->
        <section class="xeno-services-ca pb-100">
          <div class="container-fluid">
            <div class="xeno-image-box text-center" data-aos="fade-up" data-aos-duration="1000">
              <img src="/assets/images/innerpage/banner/page-banner2.jpg" alt="page banner image">
            </div>
          </div>

          <Services />
        </section>
      </main>

      <Footer />
    </div>
  </div>
</InnerLayout>
