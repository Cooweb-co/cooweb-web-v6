---
import InnerLayout from '../layouts/InnerLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageBanner from '../components/PageBanner.astro';

const projects = [
  {
    id: 1,
    title: 'Portfolio Pages Mobile Apps Design',
    categories: ['Mobile Apps', 'Design'],
    image: '/assets/images/innerpage/project/project1.jpg'
  },
  {
    id: 2,
    title: 'Landing Pages Design & Branding',
    categories: ['Mobile Apps', 'Design'],
    image: '/assets/images/innerpage/project/project2.jpg'
  },
  {
    id: 3,
    title: 'Beautiful Portfolio Website Design',
    categories: ['Mobile Apps', 'Design'],
    image: '/assets/images/innerpage/project/project3.jpg'
  },
  {
    id: 4,
    title: 'Digital Agency Website Design',
    categories: ['Mobile Apps', 'Design'],
    image: '/assets/images/innerpage/project/project4.jpg'
  },
  {
    id: 5,
    title: 'Creative Landing Page Design',
    categories: ['Web Design', 'Branding'],
    image: '/assets/images/innerpage/project/project5.jpg'
  },
  {
    id: 6,
    title: 'E-Commerce Platform Development',
    categories: ['Development', 'UX/UI'],
    image: '/assets/images/innerpage/project/project6.jpg'
  }
];
---

<InnerLayout
  title="Our Projects - Xeno Creative Agency"
  description="Explore our portfolio of successful projects and creative solutions"
  keywords="projects, portfolio, works, case studies, our work"
>
  <Header />

  <div id="smooth-wrapper">
    <div id="smooth-content">
      <main>
        <PageBanner
          subtitle="Explore Our Projects"
          title="Building Landing Page<br>and Develop UX Visual<br>Brand Identity"
        />

        <!--====== Start Project Section ======-->
        <section class="xeno-project-sec pb-130">
          <div class="container">
            <div class="row">
              {projects.map((project) => (
                <div class="col-lg-6">
                  <!--=== Xeno Project Item ===-->
                  <div class="xeno-project-item mb-40" data-aos="fade-up" data-aos-duration="800">
                    <div class="thumbnail">
                      <img src={project.image} alt={project.title}>
                    </div>
                    <div class="content-wrap">
                      <div class="content">
                        <div class="project-categories">
                          {project.categories.map((category) => (
                            <a href="#">{category}</a>
                          ))}
                        </div>
                        <h4 class="title">
                          <a href="/project-details">{project.title}</a>
                        </h4>
                      </div>
                      <div class="button">
                        <a href="/project-details" class="icon-btn style-one">
                          <i class="far fa-arrow-right"></i>
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>
      </main>

      <Footer />
    </div>
  </div>
</InnerLayout>
