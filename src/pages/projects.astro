---
import InnerLayout from '../layouts/InnerLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageBanner from '../components/PageBanner.astro';

const projects = [
  {
    id: 1,
    title: 'DerbiPlay - Plataforma de Fútbol Amateur',
    categories: ['SportsTech', 'Mobile App', 'Impacto Social'],
    image: 'https://images.unsplash.com/photo-1579952363873-27f3bade9f55?w=800&h=600&fit=crop',
    slug: '/projects/derbiplay',
    featured: true
  },
  {
    id: 2,
    title: 'Portfolio Pages Mobile Apps Design',
    categories: ['Mobile Apps', 'Design'],
    image: '/assets/images/innerpage/project/project1.jpg',
    slug: '/project-details'
  },
  {
    id: 3,
    title: 'Landing Pages Design & Branding',
    categories: ['Mobile Apps', 'Design'],
    image: '/assets/images/innerpage/project/project2.jpg',
    slug: '/project-details'
  },
  {
    id: 4,
    title: 'Beautiful Portfolio Website Design',
    categories: ['Mobile Apps', 'Design'],
    image: '/assets/images/innerpage/project/project3.jpg',
    slug: '/project-details'
  },
  {
    id: 5,
    title: 'Digital Agency Website Design',
    categories: ['Mobile Apps', 'Design'],
    image: '/assets/images/innerpage/project/project4.jpg',
    slug: '/project-details'
  },
  {
    id: 6,
    title: 'Creative Landing Page Design',
    categories: ['Web Design', 'Branding'],
    image: '/assets/images/innerpage/project/project5.jpg',
    slug: '/project-details'
  },
  {
    id: 7,
    title: 'E-Commerce Platform Development',
    categories: ['Development', 'UX/UI'],
    image: '/assets/images/innerpage/project/project6.jpg',
    slug: '/project-details'
  }
];
---

<InnerLayout
  title="Nuestros Proyectos - CooWeb"
  description="Explora nuestro portafolio de proyectos exitosos con impacto social y tecnológico"
  keywords="proyectos, portafolio, casos de éxito, desarrollo de software, impacto social"
>
  <Header />

  <div id="smooth-wrapper">
    <div id="smooth-content">
      <main>
        <PageBanner
          subtitle="Nuestros Proyectos"
          title="Construyendo Soluciones <br> con Impacto Real"
        />

        <!--====== Start Project Section ======-->
        <section class="xeno-project-sec pb-130">
          <div class="container">
            <div class="row">
              {projects.map((project) => (
                <div class="col-lg-6">
                  <!--=== Xeno Project Item ===-->
                  <div class="xeno-project-item mb-40" data-aos="fade-up" data-aos-duration="800">
                    <div class="thumbnail">
                      <img src={project.image} alt={project.title}>
                    </div>
                    <div class="content-wrap">
                      <div class="content">
                        <div class="project-categories">
                          {project.categories.map((category) => (
                            <a href="#">{category}</a>
                          ))}
                        </div>
                        <h4 class="title">
                          <a href={project.slug}>{project.title}</a>
                        </h4>
                      </div>
                      <div class="button">
                        <a href={project.slug} class="icon-btn style-one">
                          <i class="far fa-arrow-right"></i>
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>
      </main>

      <Footer />
    </div>
  </div>
</InnerLayout>
