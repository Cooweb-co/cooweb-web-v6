---
import InnerLayout from '../layouts/InnerLayout.astro';
import Header from '../components/Header.astro';
---

<InnerLayout
  title="404 - Page Not Found"
  description="The page you're looking for doesn't exist"
>
  <Header />

  <div id="smooth-wrapper">
    <div id="smooth-content">
      <main>
        <!--====== Start 404 Section ======-->
        <section class="xeno-error-sec p-r z-1">
          <div class="shape shape-one"><span></span></div>
          <div class="shape shape-two"><span></span></div>
          <div class="shape shape-three"><span></span></div>
          <div class="shape shape-four"><span></span></div>
          <div class="container">
            <div class="row">
              <div class="col-lg-12">
                <!-- Xeno Content Box -->
                <div class="xeno-content-box text-center">
                  <img src="/assets/images/innerpage/404/404.png" alt="404 Error">
                  <h1>OPPS! This Pages Can't Be Found</h1>
                  <p>
                    It seems like the page you're looking for has gone missing. Don't worry—it
                    happens to the best
                  </p>
                  <div class="xeno-button">
                    <a href="/" class="theme-btn style-one">
                      Go To Homepage<i class="far fa-angle-double-right"></i>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>
      </main>
    </div>
  </div>
</InnerLayout>
