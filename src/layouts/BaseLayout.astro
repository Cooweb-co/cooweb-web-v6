---
export interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
  keywords?: string;
}

const {
  title = 'Xeno - Creative Digital Agency',
  description = 'Creative Agency, design studio, web agency, marketing agency',
  image = '/assets/images/creative-agency/favicon.png',
  canonical = Astro.url.pathname,
  keywords = 'creative agency, digital agency, web design, marketing, branding'
} = Astro.props;

const canonicalURL = new URL(canonical, Astro.site);
---

<!DOCTYPE html>
<html lang="es">
<head>
  <!--====== Required meta tags ======-->
  <meta charset="utf-8">
  <meta http-equiv="x-ua-compatible" content="ie=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

  <!--====== SEO meta tags ======-->
  <meta name="description" content={description}>
  <meta name="keywords" content={keywords}>
  <link rel="canonical" href={canonicalURL}>

  <!--====== Open Graph / Facebook ======-->
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonicalURL}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={image}>

  <!--====== Twitter ======-->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content={canonicalURL}>
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={image}>

  <!--====== Title ======-->
  <title>{title}</title>

  <!--====== Favicon Icon ======-->
  <link rel="shortcut icon" href="/assets/images/creative-agency/favicon.png" type="image/png">

  <!--====== Google Fonts ======-->
  <link href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,300..900;1,300..900&family=Sora:wght@100..800&display=swap" rel="stylesheet">

  <!--====== Flaticon css ======-->
  <link rel="stylesheet" href="/assets/fonts/flaticon/flaticon_xeno.css">

  <!--====== FontAwesome css ======-->
  <link rel="stylesheet" href="/assets/fonts/fontawesome/css/all.min.css">

  <!--====== Bootstrap css ======-->
  <link rel="stylesheet" href="/assets/css/plugins/bootstrap.min.css">

  <!--====== Slick-popup css ======-->
  <link rel="stylesheet" href="/assets/css/plugins/slick.css">

  <!--====== Magnific-popup css ======-->
  <link rel="stylesheet" href="/assets/css/plugins/magnific-popup.css">

  <!--====== AOS Animation ======-->
  <link rel="stylesheet" href="/assets/css/plugins/aos.css">

  <!--====== Spacings css ======-->
  <link rel="stylesheet" href="/assets/css/spacings.css">

  <!--====== Common Style css ======-->
  <link rel="stylesheet" href="/assets/css/common-style.css">

  <!--====== Style css ======-->
  <link rel="stylesheet" href="/assets/css/pages/xeno-creative-agency.css">
</head>
<body class="creative-agency">
  <!--====== Preloader ======-->
  <div class="preloader">
    <div class="loading-wrapper">
      <div class="loading"></div>
      <div id="loading-icon"><img src="/assets/images/creative-agency/loader.png" alt="loader"></div>
    </div>
  </div>

  <!--====== Start Overlay ======-->
  <div class="offcanvas__overlay"></div>

  <slot />

  <!--====== Jquery js ======-->
  <script is:inline src="/assets/js/plugins/jquery-3.7.1.min.js"></script>

  <!--====== Bootstrap js ======-->
  <script is:inline src="/assets/js/plugins/popper.min.js"></script>
  <script is:inline src="/assets/js/plugins/bootstrap.min.js"></script>

  <!--====== Gsap Js ======-->
  <script is:inline src="/assets/js/plugins/gsap/gsap.min.js"></script>
  <script is:inline src="/assets/js/plugins/gsap/SplitText.min.js"></script>
  <script is:inline src="/assets/js/plugins/gsap/ScrollSmoother.min.js"></script>
  <script is:inline src="/assets/js/plugins/gsap/ScrollTrigger.min.js"></script>

  <!--====== Waypoint js ======-->
  <script is:inline src="/assets/js/plugins/jquery.waypoints.js"></script>

  <!--====== CounterUp js ======-->
  <script is:inline src="/assets/js/plugins/jquery.counterup.min.js"></script>

  <!--====== Slick js ======-->
  <script is:inline src="/assets/js/plugins/slick.min.js"></script>

  <!--====== Magnific js ======-->
  <script is:inline src="/assets/js/plugins/jquery.magnific-popup.min.js"></script>

  <!--====== AOS js ======-->
  <script is:inline src="/assets/js/plugins/aos.js"></script>

  <!--====== Main js ======-->
  <script is:inline src="/assets/js/common.js"></script>

  <!--====== Creative Agency js ======-->
  <script is:inline src="/assets/js/creative-agency.js"></script>
</body>
</html>
