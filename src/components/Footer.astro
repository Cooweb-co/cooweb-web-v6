---
// Footer Component - CooWeb
const currentYear = new Date().getFullYear();
---

<footer class="xeno-footer-ca">
  <div class="big-text" data-aos="fade-up" data-aos-delay="30" data-aos-duration="700">CooWeb</div>
  <div class="shape circle-shape-one cl-one"><span></span></div>
  <div class="shape circle-shape-two"><span></span></div>

  <div class="footer-top pt-80 pb-80">
    <!-- Client Slider -->
    <div class="company-slider">
      <!-- Client Item -->
      {[1, 2, 3, 4, 5, 6, 4].map((num) => (
        <div class="client-item">
          <div class="client-img">
            <a href="/"><img src={`/assets/images/creative-agency/company/company${num}.png`} alt="Company"></a>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Footer Bottom -->
  <div class="footer-bottom pt-100">
    <div class="container">
      <div class="row">
        <div class="col-md-5">
          <!-- Footer Content -->
          <div class="footer-content mb-20" data-aos="fade-up" data-aos-delay="10" data-aos-duration="300">
            <h5>¿Listo para Conectar?</h5>
            <p class="mb-3"><strong>CooWeb LLC</strong></p>
            <p class="small">🇺🇸 USA | 🇨🇴 Colombia</p>
            <p class="small">Barranquilla | Medellín</p>
          </div>
        </div>
        <div class="col-md-7">
          <!-- Footer Content Box -->
          <div class="footer-content-box">
            <div class="xeno-info-box mb-60" data-aos="fade-up" data-aos-delay="15" data-aos-duration="400">
              <div class="content">
                <h3><a href="mailto:info@cooweb.co">info@cooweb.co</a></h3>
                <h3><a href="tel:+573001234567">+57 (300) 123-4567</a></h3>
                <a href="/contact" class="theme-btn style-one">
                  Hablemos de tu Proyecto <i class="far fa-angle-double-right"></i>
                </a>
              </div>
            </div>

            <!-- Social Box -->
            <div class="social-box mb-60" data-aos="fade-up" data-aos-delay="20" data-aos-duration="500">
              <a href="https://www.linkedin.com/company/cooweb" aria-label="LinkedIn">LinkedIn</a>
              <a href="https://www.facebook.com/cooweb" aria-label="Facebook">Facebook</a>
              <a href="https://www.instagram.com/cooweb" aria-label="Instagram">Instagram</a>
              <a href="https://twitter.com/cooweb" aria-label="Twitter">Twitter</a>
              <a href="https://github.com/cooweb" aria-label="GitHub">GitHub</a>
            </div>

            <!-- Footer Copyright -->
            <div class="footer-copyright" data-aos="fade-up" data-aos-delay="25" data-aos-duration="600">
              <p>Copyright © {currentYear} - <span>CooWeb LLC</span>. Todos los derechos reservados.</p>
              <p class="small mt-2">Transformando el futuro con tecnología e impacto social 🚀</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>
