---
// Footer Component
const currentYear = new Date().getFullYear();
---

<footer class="xeno-footer-ca">
  <div class="big-text" data-aos="fade-up" data-aos-delay="30" data-aos-duration="700">xeno</div>
  <div class="shape circle-shape-one cl-one"><span></span></div>
  <div class="shape circle-shape-two"><span></span></div>

  <div class="footer-top pt-80 pb-80">
    <!-- Client Slider -->
    <div class="company-slider">
      <!-- Client Item -->
      {[1, 2, 3, 4, 5, 6, 4].map((num) => (
        <div class="client-item">
          <div class="client-img">
            <a href="/"><img src={`/assets/images/creative-agency/company/company${num}.png`} alt="Company"></a>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Footer Bottom -->
  <div class="footer-bottom pt-100">
    <div class="container">
      <div class="row">
        <div class="col-md-5">
          <!-- Footer Content -->
          <div class="footer-content mb-20" data-aos="fade-up" data-aos-delay="10" data-aos-duration="300">
            <h5>Ready to Reach Out</h5>
          </div>
        </div>
        <div class="col-md-7">
          <!-- Footer Content Box -->
          <div class="footer-content-box">
            <div class="xeno-info-box mb-60" data-aos="fade-up" data-aos-delay="15" data-aos-duration="400">
              <div class="content">
                <h3><a href="mailto:example@gmail.com">example@gmail.com</a></h3>
                <h3><a href="tel:+1(234)568-9023">+1 (234) 568-9023</a></h3>
                <a href="/contact" class="theme-btn style-one">
                  Let's Talk With Us <i class="far fa-angle-double-right"></i>
                </a>
              </div>
            </div>

            <!-- Social Box -->
            <div class="social-box mb-60" data-aos="fade-up" data-aos-delay="20" data-aos-duration="500">
              <a href="#" aria-label="Facebook">Facebook</a>
              <a href="#" aria-label="LinkedIn">LinkedIn</a>
              <a href="#" aria-label="Instagram">Instagram</a>
              <a href="#" aria-label="Dribbble">Dribbble</a>
              <a href="#" aria-label="Behance">Behance</a>
            </div>

            <!-- Footer Copyright -->
            <div class="footer-copyright" data-aos="fade-up" data-aos-delay="25" data-aos-duration="600">
              <p>Copyright © {currentYear} - <span>Xeno</span>, All Rights Reserved.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>
