const projects = [
  {
    id: 1,
    title: 'Portfolio Pages Mobile Apps Design',
    categories: ['Mobile Apps', 'Design'],
    image: '/assets/images/creative-agency/project/project1.jpg',
    delay: 800
  },
  {
    id: 2,
    title: 'Landing Pages Design & Branding',
    categories: ['Mobile Apps', 'Design'],
    image: '/assets/images/creative-agency/project/project2.jpg',
    delay: 1000
  },
  {
    id: 3,
    title: 'Beautiful Portfolio Website Design',
    categories: ['Mobile Apps', 'Design'],
    image: '/assets/images/creative-agency/project/project3.jpg',
    delay: 1200
  },
  {
    id: 4,
    title: 'Digital Agency Website Design',
    categories: ['Mobile Apps', 'Design'],
    image: '/assets/images/creative-agency/project/project4.jpg',
    delay: 1400
  },
  {
    id: 5,
    title: 'Digital Agency Website Design',
    categories: ['Mobile Apps', 'Design'],
    image: '/assets/images/creative-agency/project/project5.jpg',
    delay: 1600
  },
  {
    id: 6,
