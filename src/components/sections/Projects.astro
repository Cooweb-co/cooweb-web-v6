---
// Projects Section Component - CooWeb Real Cases
const projects = [
  {
    id: 1,
    title: 'DerbiPlay - Plataforma de Fútbol Amateur',
    categories: ['SportsTech', 'Colombia'],
    image: 'https://images.unsplash.com/photo-1574629810360-7efbbe195018?w=800&auto=format&fit=crop&q=80',
    delay: 800
  },
  {
    id: 2,
    title: 'Plannity - Eventos con IA',
    categories: ['EventTech', 'IA'],
    image: 'https://images.unsplash.com/photo-1540575467063-178a50c2df87?w=800&auto=format&fit=crop&q=80',
    delay: 1000
  },
  {
    id: 3,
    title: 'Raudoc - Gestión Documental IA',
    categories: ['LegalTech', 'SaaS'],
    image: 'https://images.unsplash.com/photo-1450101499163-c8848c66ca85?w=800&auto=format&fit=crop&q=80',
    delay: 1200
  },
  {
    id: 4,
    title: 'Kila - Logística Internacional IA',
    categories: ['LogisticsTech', 'USA'],
    image: 'https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?w=800&auto=format&fit=crop&q=80',
    delay: 1400
  },
  {
    id: 5,
    title: 'Telemed - Telemedicina 24/7',
    categories: ['HealthTech', 'RD'],
    image: 'https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?w=800&auto=format&fit=crop&q=80',
    delay: 1600
  },
  {
    id: 6,
    title: 'DESIGNA - Smart Parking',
    categories: ['PropTech', 'Alemania'],
    image: 'https://images.unsplash.com/photo-1506521781263-d8422e82f27a?w=800&auto=format&fit=crop&q=80',
    delay: 1800
  }
];
---

<section class="xeno-project-ca pt-155 pb-125">
  <div class="container">
    <div class="row">
      <div class="col-lg-12">
        <!-- Section Title -->
        <div class="section-title style-one mb-60">
          <h2 class="text-anm-three"><span class="thin-200">Proyectos</span> Destacados</h2>
          <p data-aos="fade-up" data-aos-delay="20" data-aos-duration="500">
            170+ proyectos exitosos en 3 continentes. Soluciones reales que transforman
            industrias, desde deportes y logística hasta salud y legaltech. Innovación con IA y tecnología de punta.
          </p>
        </div>
      </div>
    </div>
  </div>
  <div class="container-fluid">
    <div class="xeno-project-item-list">
      {projects.map((project) => (
        <div class="xeno-project-item" data-aos="fade-up" data-aos-duration={project.delay}>
          <div class="thumbnail">
            <img src={project.image} alt={project.title}>
          </div>
          <div class="content-wrap">
            <div class="content">
              <div class="project-categories">
                {project.categories.map((category) => (
                  <a href="#">{category}</a>
                ))}
              </div>
              <h4 class="title">
                <a href="/project-details">{project.title}</a>
              </h4>
            </div>
            <div class="button">
              <a href="/project-details" class="icon-btn style-one">
                <i class="far fa-arrow-right"></i>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
