---

<section class="xeno-project-ca pt-155 pb-125">
  <div class="container">
    <div class="row">
      <div class="col-lg-12">
        <!-- Section Title -->
        <div class="section-title style-one mb-60">
          <h2 class="text-anm-three"><span class="thin-200">Features</span> Works</h2>
          <p data-aos="fade-up" data-aos-delay="20" data-aos-duration="500">
            We take pride in the accolades and recognitions we've earned throughout
            our journey. Our achievements are a testament to the dedication, creativity,
            and results-driven approach we bring to every project.
          </p>
        </div>
      </div>
    </div>
  </div>
  <div class="container-fluid">
    <div class="xeno-project-item-list">
      {projects.map((project) => (
        <div class="xeno-project-item" data-aos="fade-up" data-aos-duration={project.delay}>
          <div class="thumbnail">
            <img src={project.image} alt={project.title}>
          </div>
          <div class="content-wrap">
            <div class="content">
              <div class="project-categories">
                {project.categories.map((category) => (
                  <a href="#">{category}</a>
                ))}
              </div>
              <h4 class="title">
                <a href="/project-details">{project.title}</a>
              </h4>
            </div>
            <div class="button">
              <a href="/project-details" class="icon-btn style-one">
                <i class="far fa-arrow-right"></i>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
