---
// Services Section Component - CooWeb
const services = [
  {
    id: 1,
    title: 'Desarrollo de Software',
    description: 'Apps web y móviles con tecnología de punta. Microservicios, APIs, integración IA y Cloud Native.',
    image: 'https://images.unsplash.com/photo-1498050108023-c5249f4df085?w=600&auto=format&fit=crop&q=80',
    active: true
  },
  {
    id: 2,
    title: 'Consultoría Tecnológica',
    description: 'Asesoría estratégica para tu transformación digital. Roadmap tech, arquitectura y estrategia IA.',
    image: 'https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=600&auto=format&fit=crop&q=80'
  },
  {
    id: 3,
    title: 'Equipos Dedicados',
    description: 'Talento nearshore para potenciar tu equipo. Devs senior, arquitectos, especialistas IA y DevOps.',
    image: 'https://images.unsplash.com/photo-1600880292203-757bb62b4baf?w=600&auto=format&fit=crop&q=80'
  },
  {
    id: 4,
    title: 'Innovación con IA',
    description: 'Soluciones avanzadas de IA para tu negocio. ML, NLP, Computer Vision, GenAI y automatización.',
    image: 'https://images.unsplash.com/photo-1677442136019-21780ecad995?w=600&auto=format&fit=crop&q=80'
  }
];

const features = [
  '60% más eficiencia con IA',
  '15+ años de experiencia',
  'Talento nearshore de élite'
];
---

<section class="xeno-services-ca pt-155 pb-100">
  <div class="container">
    <div class="row">
      <div class="col-lg-12">
        <!-- Section Title -->
        <div class="section-title style-one mb-60">
          <h2 class="text-anm-three"><span class="thin">Nuestros </span> Servicios</h2>
          <p data-aos="fade-up" data-aos-delay="20" data-aos-duration="500">
            Soluciones tecnológicas integrales que transforman desafíos en ventajas competitivas.
            Desde desarrollo hasta innovación con IA, con un enfoque en resultados medibles y talento de élite.
          </p>
        </div>
      </div>
    </div>
    <div class="row justify-content-end">
      <div class="col-lg-8">
        <!-- CA Service List -->
        <div class="ca-service-list accordion" id="serviceAccordion" data-aos="fade-up" data-aos-duration="600">
          {services.map((service) => (
            <div class={`xeno-service-item ${service.active ? 'service-active' : ''}`}>
              <div class="service-header">
                <h6
                  class="service-title"
                  data-bs-toggle="collapse"
                  data-bs-target={`#collapse${service.id}`}
                  aria-expanded={service.active ? 'true' : 'false'}
                >
                  <span class="number">{String(service.id).padStart(2, '0')}</span>
                  {service.title}
                </h6>
              </div>
              <div
                id={`collapse${service.id}`}
                class={`accordion-collapse collapse ${service.active ? 'show' : ''}`}
                data-bs-parent="#serviceAccordion"
              >
                <div class="service-content">
                  <div class="row">
                    <div class="col-md-6">
                      <div class="thumbnail mb-15">
                        <img src={service.image} alt={`${service.title} Image`}>
                      </div>
                    </div>
                    <div class="col-md-6">
                      <div class="content mb-15">
                        <p>{service.description}</p>
                        <ul class="check-list style-one">
                          {features.map((feature) => (
                            <li><i class="far fa-check"></i>{feature}</li>
                          ))}
                        </ul>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
