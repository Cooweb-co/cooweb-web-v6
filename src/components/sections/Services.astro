---
// Services Section Component
const services = [
  {
    id: 1,
    title: 'Brand Strategy and Identity Development',
    description: 'Crafting a cohesive brand strategy and designing logos, color schemes visual identities with target',
    image: '/assets/images/creative-agency/gallery/service.png',
    active: true
  },
  {
    id: 2,
    title: 'Web Design and Development',
    description: 'Crafting a cohesive brand strategy and designing logos, color schemes visual identities with target',
    image: '/assets/images/creative-agency/gallery/service2.png'
  },
  {
    id: 3,
    title: 'Content Creation and Marketing',
    description: 'Crafting a cohesive brand strategy and designing logos, color schemes visual identities with target',
    image: '/assets/images/creative-agency/gallery/service3.png'
  },
  {
    id: 4,
    title: 'Search Engine Optimization (SEO)',
    description: 'Crafting a cohesive brand strategy and designing logos, color schemes visual identities with target',
    image: '/assets/images/creative-agency/gallery/service4.png'
  },
  {
    id: 5,
    title: 'Digital Advertising and PPC Campaigns',
    description: 'Crafting a cohesive brand strategy and designing logos, color schemes visual identities with target',
    image: '/assets/images/creative-agency/gallery/service5.png'
  },
  {
    id: 6,
    title: '(UX) and (UI) Design',
    description: 'Crafting a cohesive brand strategy and designing logos, color schemes visual identities with target',
    image: '/assets/images/creative-agency/gallery/service6.png'
  },
  {
    id: 7,
    title: 'Video Production and Animation',
    description: 'Crafting a cohesive brand strategy and designing logos, color schemes visual identities with target',
    image: '/assets/images/creative-agency/gallery/service7.png'
  }
];

const features = [
  'Creative digital solutions',
  'Expert team members',
  '250+ awards winning'
];
---

<section class="xeno-services-ca pt-155 pb-100">
  <div class="container">
    <div class="row">
      <div class="col-lg-12">
        <!-- Section Title -->
        <div class="section-title style-one mb-60">
          <h2 class="text-anm-three"><span class="thin">Explore </span> Services</h2>
          <p data-aos="fade-up" data-aos-delay="20" data-aos-duration="500">
            We take pride in the accolades and recognitions we've earned throughout
            our journey. Our achievements are a testament to the dedication, creativity,
            and results-driven approach we bring to every project.
          </p>
        </div>
      </div>
    </div>
    <div class="row justify-content-end">
      <div class="col-lg-8">
        <!-- CA Service List -->
        <div class="ca-service-list accordion" id="serviceAccordion" data-aos="fade-up" data-aos-duration="600">
          {services.map((service) => (
            <div class={`xeno-service-item ${service.active ? 'service-active' : ''}`}>
              <div class="service-header">
                <h6
                  class="service-title"
                  data-bs-toggle="collapse"
                  data-bs-target={`#collapse${service.id}`}
                  aria-expanded={service.active ? 'true' : 'false'}
                >
                  <span class="number">{String(service.id).padStart(2, '0')}</span>
                  {service.title}
                </h6>
              </div>
              <div
                id={`collapse${service.id}`}
                class={`accordion-collapse collapse ${service.active ? 'show' : ''}`}
                data-bs-parent="#serviceAccordion"
              >
                <div class="service-content">
                  <div class="row">
                    <div class="col-md-6">
                      <div class="thumbnail mb-15">
                        <img src={service.image} alt={`${service.title} Image`}>
                      </div>
                    </div>
                    <div class="col-md-6">
                      <div class="content mb-15">
                        <p>{service.description}</p>
                        <ul class="check-list style-one">
                          {features.map((feature) => (
                            <li><i class="far fa-check"></i>{feature}</li>
                          ))}
                        </ul>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
