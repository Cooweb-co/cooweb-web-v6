---
// Counter Section Component - CooWeb
const stats = [
  {
    number: '15',
    symbol: '+',
    title: 'Años de Experiencia',
    description: 'Transformando empresas con tecnología innovadora en múltiples industrias',
    icon: 'flaticon-verified',
    delay: 600
  },
  {
    number: '170',
    symbol: '+',
    title: 'Proyectos Exitosos',
    description: 'Soluciones implementadas en América, Europa y LATAM con resultados medibles',
    icon: 'flaticon-full-time',
    delay: 800
  },
  {
    number: '60',
    suffix: '%',
    symbol: '',
    title: 'Más Eficiencia con IA',
    description: 'Incremento en productividad mediante soluciones potenciadas por inteligencia artificial',
    icon: 'flaticon-tech-service',
    delay: 1000
  },
  {
    number: '50',
    symbol: '+',
    title: 'Jóvenes Formados',
    description: 'Programa de impacto social AI Product Engineering desarrollando el talento del futuro',
    icon: 'flaticon-best-customer-experience',
    delay: 1200
  }
];
---

<section class="xeno-counter-ca pt-155 pb-90">
  <div class="container">
    <div class="row">
      <div class="col-lg-12">
        <!-- Section Title -->
        <div class="section-title title-white style-one mb-60">
          <h2 class="text-anm-three">
            <span class="thin-200">Resultados </span> Medibles <span class="regular">que Hablan por Sí Solos</span>
          </h2>
          <p data-aos="fade-up" data-aos-delay="20" data-aos-duration="500">
            Nuestros logros son el testimonio de 15+ años de dedicación, innovación tecnológica
            y compromiso genuino con el desarrollo del talento local. Cada número refleja nuestro
            impacto en la transformación digital de empresas y en la formación de la próxima generación de profesionales.
          </p>
        </div>
      </div>
    </div>
    <div class="row">
      {stats.map((stat) => (
        <div class="col-lg-3 col-md-6 col-sm-12">
          <div class="xeno-counter-item mb-40" data-aos="fade-up" data-aos-duration={stat.delay}>
            <div class="content-icon-wrap">
              <div class="content">
                <h2>
                  <span class="counter">{stat.number}</span>
                  {stat.suffix && stat.suffix}
                  {stat.symbol && <span class="symbol">{stat.symbol}</span>}
                </h2>
                <span class="text">{stat.title}</span>
              </div>
              <div class="icon">
                <i class={stat.icon}></i>
              </div>
            </div>
            <p>{stat.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
