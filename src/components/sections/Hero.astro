---
// Hero Section Component - CooWeb
interface Props {
  subtitle?: string;
  title?: string;
  description?: string;
}

const {
  subtitle = 'Innovación Tech + Impacto Social',
  title = 'Transformamos el Futuro con Tecnología e Impacto Social',
  description = 'Tu socio estratégico en innovación tecnológica. Expertise de clase mundial con compromiso real por el talento local. CooWeb LLC (USA) + Colombia.'
} = Astro.props;
---

<section class="xeno-hero">
  <div class="xeno-hero-ca">
    <div class="shape circle-shape-one"><span></span></div>
    <div class="shape circle-shape-two"><span></span></div>
    <div class="hero-image hero-image-one pl-one">
      <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=800&auto=format&fit=crop&q=80" alt="Equipo colaborando en tecnología">
    </div>
    <div class="hero-image hero-image-two pl-two">
      <img src="https://images.unsplash.com/photo-1531482615713-2afd69097998?w=800&auto=format&fit=crop&q=80" alt="Innovación y desarrollo tech">
    </div>
    <div class="container">
      <div class="row">
        <div class="col-lg-12">
          <!-- Hero Content -->
          <div class="hero-content">
            <span class="sub-text" data-aos="fade-up" data-aos-duration="1500">{subtitle}</span>
            <h1 class="text-anm">
              <span class="text-one">Transformamos</span> el Futuro
              <span class="avatar-thumb">
                <img src="https://images.unsplash.com/photo-1573497019940-1c28c88b4f3e?w=200&auto=format&fit=crop&q=80" alt="CooWeb Team">
              </span>
              con Tecnología e <span class="text-two">Impacto Social</span>
            </h1>
          </div>
        </div>
      </div>
      <div class="row">
        <div class="col-lg-12">
          <!-- Xeno Text Box -->
          <div class="xeno-text-box" data-aos="fade-up" data-aos-duration="600" data-aos-delay="30">
            <p>{description}</p>
            <div class="xeno-button">
              <a href="/services" class="theme-btn style-one">
                Conoce Nuestros Servicios<i class="far fa-angle-double-right"></i>
              </a>
              <a href="/ai-product-engineering" class="play-btn style-one">
                <div class="icon"><i class="far fa-graduation-cap"></i></div>
                <span>Nuestro Impacto Social</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
