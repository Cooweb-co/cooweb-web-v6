---
// Blog Section Component - CooWeb Insights
const blogs = [
  {
    id: 1,
    title: 'AI Product Engineering: Construyendo el Talento del Futuro',
    category: 'Impacto Social',
    date: '15 Octubre 2025',
    image: 'https://images.unsplash.com/photo-1509062522246-3755977927d7?w=600&auto=format&fit=crop&q=80',
    delay: 10,
    duration: 600
  },
  {
    id: 2,
    title: 'Nearshore en Colombia: Ventajas del Talento Tech LATAM',
    category: 'Tech Talent',
    date: '10 Octubre 2025',
    image: 'https://images.unsplash.com/photo-1552664730-d307ca884978?w=600&auto=format&fit=crop&q=80',
    delay: 20,
    duration: 800
  },
  {
    id: 3,
    title: 'IA Generativa en Productos Digitales: Casos de Uso Reales',
    category: 'IA & ML',
    date: '01 Octubre 2025',
    image: 'https://images.unsplash.com/photo-1655720828018-edd2daec9349?w=600&auto=format&fit=crop&q=80',
    delay: 30,
    duration: 1000
  }
];
---

<section class="xeno-blogs-ca pt-155 pb-90">
  <div class="container">
    <div class="row">
      <div class="col-lg-12">
        <!-- Section Title -->
        <div class="section-title style-one mb-60">
          <h2 class="text-anm-three"><span class="thin">Últimas</span> Publicaciones</h2>
          <p data-aos="fade-up" data-aos-delay="20" data-aos-duration="500">
            Insights sobre IA, talento tech y transformación digital.
            Compartimos conocimiento para impulsar la innovación en LATAM.
          </p>
        </div>
      </div>
    </div>
    <div class="row">
      {blogs.map((blog) => (
        <div class="col-lg-4 col-md-6 col-sm-12">
          <div class="xeno-blog-post mb-40" data-aos="fade-up" data-aos-delay={blog.delay} data-aos-duration={blog.duration}>
            <div class="thumbnail">
              <img src={blog.image} alt={blog.title}>
            </div>
            <div class="content">
              <div class="post-meta">
                <span><a href="#">{blog.category}</a></span>
                <span>{blog.date}</span>
              </div>
              <h4 class="title">
                <a href="/blog-details">{blog.title}</a>
              </h4>
              <a href="/blog-details" class="read-more style-one">
                Leer Más<i class="far fa-arrow-right"></i>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
