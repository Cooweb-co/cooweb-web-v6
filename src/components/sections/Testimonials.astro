---
// Testimonials Section Component
const testimonials = [
  {
    id: 1,
    author: 'Pat M. Penniman',
    position: 'CEO & Director',
    avatar: '/assets/images/creative-agency/testimonial/author1.jpg',
    company: '/assets/images/creative-agency/testimonial/company1.png',
    text: 'Partnering with Your Agency Name was a turning point for our business. Their innovative strategies a expert guidance helped achieve systems remarkable growth record time!'
  },
  {
    id: 2,
    author: 'Pat M. Penniman',
    position: 'CEO & Director',
    avatar: '/assets/images/creative-agency/testimonial/author2.jpg',
    company: '/assets/images/creative-agency/testimonial/company2.png',
    text: 'Partnering with Your Agency Name was a turning point for our business. Their innovative strategies a expert guidance helped achieve systems remarkable growth record time!'
  },
  {
    id: 3,
    author: 'Pat M. Penniman',
    position: 'CEO & Director',
    avatar: '/assets/images/creative-agency/testimonial/author3.jpg',
    company: '/assets/images/creative-agency/testimonial/company3.png',
    text: 'Partnering with Your Agency Name was a turning point for our business. Their innovative strategies a expert guidance helped achieve systems remarkable growth record time!'
  }
];

const clientAvatars = [
  '/assets/images/creative-agency/testimonial/avatar1.jpg',
  '/assets/images/creative-agency/testimonial/avatar2.jpg',
  '/assets/images/creative-agency/testimonial/avatar3.jpg'
];
---

<section class="xeno-testimonial-ca pt-155 pb-100">
  <div class="container">
    <div class="row">
      <div class="col-lg-12">
        <!-- Section Title -->
        <div class="section-title style-one title-white mb-60">
          <h2 class="text-anm-three"><span class="thin">Our</span> Testimonials</h2>
          <p data-aos="fade-up" data-aos-delay="20" data-aos-duration="500">
            We take pride in the accolades and recognitions we've earned throughout
            our journey. Our achievements are a testament to the dedication, creativity,
            and results-driven approach we bring to every project.
          </p>
        </div>
      </div>
    </div>
    <div class="row">
      <div class="col-lg-4">
        <!-- CA Testimonial Box -->
        <div class="ca-testimonial-box mb-40">
          <div class="xeno-fixed-item">
            <div class="ca-experience-box-two">
              <h2>30<span class="symbol">+</span></h2>
              <p>
                With 30 years of experience, we bring unparalleled expertise,
                innovation, and reliability to every project
              </p>
              <div class="author-client-box">
                <h5>10m+ Trusted Clients</h5>
                <ul>
                  {clientAvatars.map((avatar) => (
                    <li><img src={avatar} alt="avatar"></li>
                  ))}
                  <li><a href="#">+</a></li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-lg-8">
        <!-- Testimonial List -->
        <div class="ca-testimonial-list mb-40">
          {testimonials.map((testimonial) => (
            <div class="xeno-testimonial-item mb-3">
              <div class="testimonial-inner-content">
                <div class="testimonial-left">
                  <div class="author-thumb">
                    <img src={testimonial.avatar} alt={`${testimonial.author} Thumbnail`}>
                  </div>
                  <div class="company-logo">
                    <img src={testimonial.company} alt="company">
                  </div>
                </div>
                <div class="testimonial-right">
                  <p>{testimonial.text}</p>
                  <div class="author-info">
                    <h5>{testimonial.author}</h5>
                    <span class="position">{testimonial.position}</span>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
