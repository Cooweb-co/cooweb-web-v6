---
// Testimonials Section Component - CooWeb Real Clients
const testimonials = [
  {
    id: 1,
    author: 'Carlos Rodríguez',
    position: 'CEO, DerbiPlay',
    avatar: 'https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=200&auto=format&fit=crop&q=80',
    company: 'https://images.unsplash.com/photo-1599305445671-ac291c95aaa9?w=150&auto=format&fit=crop&q=80',
    text: 'CooWeb transformó nuestra visión en una plataforma robusta que conecta a miles de jugadores. Su expertise en IA y su enfoque ágil nos permitió lanzar 60% más rápido.'
  },
  {
    id: 2,
    author: 'María González',
    position: 'CTO, Plannity',
    avatar: 'https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=200&auto=format&fit=crop&q=80',
    company: 'https://images.unsplash.com/photo-1557804506-669a67965ba0?w=150&auto=format&fit=crop&q=80',
    text: 'El equipo de CooWeb no solo entregó código de calidad, sino soluciones de IA que revolucionaron nuestro producto. Socios estratégicos, no solo proveedores.'
  },
  {
    id: 3,
    author: 'John Smith',
    position: 'VP Engineering, Kila',
    avatar: 'https://images.unsplash.com/photo-1519345182560-3f2917c472ef?w=200&auto=format&fit=crop&q=80',
    company: 'https://images.unsplash.com/photo-1560179707-f14e90ef3623?w=150&auto=format&fit=crop&q=80',
    text: 'Working with CooWeb gave us access to world-class nearshore talent. Their AI Product Engineering approach delivered measurable ROI in 3 months.'
  }
];

const clientAvatars = [
  'https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?w=100&auto=format&fit=crop&q=80',
  'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&auto=format&fit=crop&q=80',
  'https://images.unsplash.com/photo-1547425260-76bcadfb4f2c?w=100&auto=format&fit=crop&q=80'
];
---

<section class="xeno-testimonial-ca pt-155 pb-100">
  <div class="container">
    <div class="row">
      <div class="col-lg-12">
        <!-- Section Title -->
        <div class="section-title style-one title-white mb-60">
          <h2 class="text-anm-three"><span class="thin">Lo Que Dicen</span> Nuestros Clientes</h2>
          <p data-aos="fade-up" data-aos-delay="20" data-aos-duration="500">
            Resultados reales de clientes que confiaron en CooWeb para transformar sus negocios.
            Desde startups hasta corporaciones, entregamos soluciones que generan impacto medible.
          </p>
        </div>
      </div>
    </div>
    <div class="row">
      <div class="col-lg-4">
        <!-- CA Testimonial Box -->
        <div class="ca-testimonial-box mb-40">
          <div class="xeno-fixed-item">
            <div class="ca-experience-box-two">
              <h2>15<span class="symbol">+</span></h2>
              <p>
                Años construyendo soluciones tech de clase mundial.
                Expertise en IA, Cloud y productos digitales escalables.
              </p>
              <div class="author-client-box">
                <h5>170+ Proyectos Exitosos</h5>
                <ul>
                  {clientAvatars.map((avatar) => (
                    <li><img src={avatar} alt="avatar"></li>
                  ))}
                  <li><a href="#">+</a></li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-lg-8">
        <!-- Testimonial List -->
        <div class="ca-testimonial-list mb-40">
          {testimonials.map((testimonial) => (
            <div class="xeno-testimonial-item mb-3">
              <div class="testimonial-inner-content">
                <div class="testimonial-left">
                  <div class="author-thumb">
                    <img src={testimonial.avatar} alt={`${testimonial.author} Thumbnail`}>
                  </div>
                  <div class="company-logo">
                    <img src={testimonial.company} alt="company">
                  </div>
                </div>
                <div class="testimonial-right">
                  <p>{testimonial.text}</p>
                  <div class="author-info">
                    <h5>{testimonial.author}</h5>
                    <span class="position">{testimonial.position}</span>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
