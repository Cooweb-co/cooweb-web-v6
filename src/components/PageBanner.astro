---
// Page Banner Component
interface Props {
  subtitle: string;
  title: string;
}

const { subtitle, title } = Astro.props;
---

<section class="xeno-page-banner">
  <div class="shape shape-one"><span></span></div>
  <div class="shape shape-two"><span></span></div>
  <div class="container">
    <div class="row">
      <div class="col-lg-12">
        <!-- Page Title -->
        <div class="page-title">
          <span class="sub-title" data-aos="fade-up" data-aos-duration="1200">
            {subtitle}
          </span>
          <h1 class="text-anm" set:html={title}></h1>
        </div>
      </div>
    </div>
  </div>
</section>
