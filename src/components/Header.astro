---
// Header Component
---

<header class="header-area header-one">
  <div class="container">
    <!--====  Header Navigation  ===-->
    <div class="header-navigation">
      <!--====  Header Nav Inner  ===-->
      <div class="nav-inner-menu">
        <!--====  Primary Menu  ===-->
        <div class="primary-menu">
          <!--====  Site Branding  ===-->
          <div class="site-branding">
            <a href="/" class="brand-logo">
              <img src="/assets/images/creative-agency/logo/logo-main.png" alt="Brand Logo">
            </a>
          </div>

          <!--=== Xeno Main Menu ===-->
          <div class="xeno-nav-menu">
            <!-- Xeno Menu Top -->
            <div class="xeno-menu-top d-flex justify-content-between d-block d-lg-none">
              <div class="site-branding">
                <a href="/" class="brand-logo">
                  <img src="/assets/images/creative-agency/logo/logo-main.png" alt="Brand Logo">
                </a>
              </div>
              <div class="navbar-close">
                <i class="far fa-times"></i>
              </div>
            </div>

            <!--=== Main Menu ===-->
            <nav class="main-menu">
              <ul>
                <li class="menu-item"><a href="/">Inicio</a></li>
                <li class="menu-item"><a href="/about">Nosotros</a></li>
                <li class="menu-item has-children">
                  <a href="/services">Servicios</a>
                  <ul class="sub-menu">
                    <li><a href="/services">Todos los Servicios</a></li>
                    <li><a href="/services#software-development">Desarrollo de Software</a></li>
                    <li><a href="/services#consulting">Consultoría Tecnológica</a></li>
                    <li><a href="/services#dedicated-teams">Equipos Dedicados</a></li>
                    <li><a href="/services#ai-innovation">Innovación con IA</a></li>
                  </ul>
                </li>
                <li class="menu-item"><a href="/ai-product-engineering">AI Product Engineering</a></li>
                <li class="menu-item has-children">
                  <a href="/projects">Portafolio</a>
                  <ul class="sub-menu">
                    <li><a href="/projects">Todos los Proyectos</a></li>
                    <li><a href="/projects#fintech">FinTech</a></li>
                    <li><a href="/projects#healthtech">HealthTech</a></li>
                    <li><a href="/projects#logisticstech">LogisticsTech</a></li>
                  </ul>
                </li>
                <li class="menu-item"><a href="/team">Equipo</a></li>
                <li class="menu-item"><a href="/contact">Contacto</a></li>
              </ul>
            </nav>

            <!--=== Xeno Nav Button ===-->
            <div class="xeno-nav-button mt-20 d-block d-md-none">
              <a href="/contact" class="theme-btn style-one">
                Hablemos<i class="far fa-angle-double-right"></i>
              </a>
            </div>

            <!--=== Xeno Menu Bottom ===-->
            <div class="xeno-menu-bottom mt-50 d-block d-lg-none">
              <h5>Síguenos</h5>
              <ul class="social-link">
                <li><a href="https://www.linkedin.com/company/cooweb" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a></li>
                <li><a href="https://www.facebook.com/cooweb" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a></li>
                <li><a href="https://twitter.com/cooweb" aria-label="Twitter"><i class="fab fa-twitter"></i></a></li>
                <li><a href="https://www.instagram.com/cooweb" aria-label="Instagram"><i class="fab fa-instagram"></i></a></li>
              </ul>
            </div>
          </div>

          <!--=== Header Nav Right ===-->
          <div class="nav-right-item">
            <div class="nav-button d-none d-md-block">
              <a href="/contact" class="theme-btn style-one">
                Hablemos<i class="far fa-angle-double-right"></i>
              </a>
            </div>
            <div class="navbar-toggler">
              <span></span>
              <span></span>
              <span></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>
